# Create a unique 32+ character value; never share it publicly.
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Choose an owner username and long private password (12+ characters).
ADMIN_USER=owner
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
# Set true when hosting with HTTPS.
PRODUCTION=0
# Local default is ./data. For Railway persistent volume use /data.
DATA_DIR=./data
# Your host can provide PORT automatically.
PORT=8000
